PORT=3000
NODE_ENV=development

# Deezer (API pública, no necesita clave)
DEEZER_API_URL=https://api.deezer.com
DEEZER_TIMEOUT_MS=8000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=skmusic_db

# JWT (poné un texto largo y aleatorio)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Contraseña de la cuenta "demo" que crea npm run seed:demo (mínimo 8 caracteres)
DEMO_PASSWORD=
